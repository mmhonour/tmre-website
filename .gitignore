# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
data/listings.db
data/listings.db-*
data/listings.read.db
data/listings.read.db-*
data/listing-photos.db
data/listing-photos.db-*
data/listings.bundle.db
data/listings.bundle.db-*
data/test-bundle.db

# runtime capture files — contain visitor/lead PII (IPs, names, emails); keep local only
data/visitors.json
data/visitors.json.*
data/contacts.json
data/leads.json

# vendor reference PDFs parked in docs/ — licensed MLS material, keep local only
docs/*.pdf

# local dump / probe scratch (not for commit)
.tmp-*
.tmp
tmp-khe-pta*.csv
tmp-pta-*.csv
tmp-pta-*.json
tmp-cms-scrape*.js
tmp-scrape-expr*.js
tmp-*.txt
tmp-*.json

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
*.env
r2.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify
