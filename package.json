{
  "name": "tmre-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "ensure:db": "node scripts/ensure-postgres.mjs",
    "predev": "npm run ensure:db",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "predev:webpack": "npm run ensure:db",
    "dev:webpack": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "build:netlify": "node scripts/rebuild-native-modules.cjs && node scripts/verify-native-prebuilds.cjs && node scripts/verify-server-only-shim.mjs && tsx --require ./scripts/stub-server-only.cjs scripts/prepare-netlify-bundle.ts && node scripts/bake-deploy-env.mjs && next build && node scripts/verify-netlify-tracing.mjs",
    "start": "next start",
    "lint": "eslint --cache --cache-strategy content --cache-location .eslintcache",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/run-migrations.mjs",
    "db:ping": "node --env-file=.env.local scripts/db-ping.mjs",
    "backfill:photo-index": "node --env-file=.env.local scripts/backfill-photo-index.mjs",
    "backfill:content-views": "tsx --env-file=.env.local --require ./scripts/stub-server-only.cjs scripts/backfill-content-views.ts",
    "import:khe-pta": "tsx --env-file=.env.local --require ./scripts/stub-server-only.cjs scripts/import-khe-pta-directory.ts",
    "merge:pta": "tsx --env-file=.env.local --require ./scripts/stub-server-only.cjs scripts/merge-pta-directory.ts",
    "backfill:closed-years": "tsx --env-file=.env.local --require ./scripts/stub-server-only.cjs scripts/backfill-closed-year-windows.ts",
    "warm:associated-closed-photos": "tsx --require ./scripts/stub-server-only.cjs scripts/warm-associated-closed-photos.ts",
    "discover:rets": "node --env-file=.env.local --import tsx scripts/discover-rets.ts",
    "discover:rets:history": "node --env-file=.env.local --import tsx scripts/discover-rets-history.ts",
    "probe:rets": "node --env-file=.env.local --import tsx scripts/probe-rets.ts",
    "probe:rets:furnished": "node --env-file=.env.local --import tsx scripts/probe-rets-furnished.ts",
    "probe:rets:open-houses": "node --env-file=.env.local --import tsx scripts/probe-rets-open-houses.ts",
    "sync:listings": "tsx --require ./scripts/stub-server-only.cjs scripts/sync-listings.ts",
    "sync:listings:incremental": "tsx --require ./scripts/stub-server-only.cjs scripts/sync-listings-incremental.ts",
    "dump:incremental-step-log": "tsx --require ./scripts/stub-server-only.cjs scripts/dump-incremental-step-log.ts",
    "smoke:incremental": "tsx --env-file=.env.local --require ./scripts/stub-server-only.cjs scripts/smoke-incremental-sync.ts",
    "smoke:sync-queue": "tsx --require ./scripts/stub-server-only.cjs scripts/smoke-sync-queue.ts",
    "start:mls-sync": "tsx --require ./scripts/stub-server-only.cjs services/mls-sync/server.ts",
    "sync:spotlight-status": "tsx --require ./scripts/stub-server-only.cjs scripts/sync-spotlight-status.ts",
    "sync:property-addresses": "tsx --require ./scripts/stub-server-only.cjs scripts/sync-property-addresses.ts",
    "sync:vision-addresses": "tsx --require ./scripts/stub-server-only.cjs scripts/sync-vision-addresses.ts",
    "match:vision-listings": "tsx --require ./scripts/stub-server-only.cjs scripts/match-vision-listings.ts",
    "match:vision-abbrev": "tsx --require ./scripts/stub-server-only.cjs scripts/match-vision-abbrev.ts",
    "backfill:missed-vision-pids": "tsx --require ./scripts/stub-server-only.cjs scripts/backfill-missed-vision-pids.ts",
    "scores:edge": "tsx --require ./scripts/stub-server-only.cjs scripts/rebuild-edge-scores.ts",
    "export:chats": "node scripts/export-chat-history.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@netlify/blobs": "^8.2.0",
    "better-sqlite3": "^12.11.1",
    "next": "16.2.6",
    "node-expat": "^2.4.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "rets-client": "^5.2.4",
    "server-only": "file:vendor/server-only-shim"
  },
  "overrides": {
    "server-only": "file:vendor/server-only-shim"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@netlify/plugin-nextjs": "^5.15.12",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
